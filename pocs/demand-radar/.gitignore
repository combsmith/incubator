# secrets & transient
*.env
output/*.log
# large regenerable artifacts (rebuild from scripts/data)
output/*.v1.jsonl
output/keywords.jsonl
dashboard.html
# per-run weekly outputs (issue #186): rebuilt every run, shipped as build artifacts / on
# Pages; week-to-week state travels in the demand-radar-state artifact, not in git
output/weekly-digest.md
output/signals-comment.md
output/keywords.weekly.jsonl
output/keywords.weekly-slice.jsonl
output/*.tmp
# Python bytecode & test cache (see combsmith/.github#1081)
__pycache__/
*.py[cod]
.pytest_cache/
# Coverage data (regenerated by pytest-cov in CI; never committed — the SQLite
# .coverage binary tripped SonarCloud's text/secrets analysis when tracked)
.coverage
coverage.xml
